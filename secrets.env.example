# meeting-guard secrets file.
# install.sh copies this to ~/.config/meeting-guard/secrets.env with mode 600.
# meeting-guard refuses to read it unless it is a regular file owned by you
# with no group/other permissions (chmod 600), and not a symlink.
# Values set in the process environment take precedence over this file.

# ntfy push (optional, off while empty). Anyone who knows the topic can read
# and send your notifications: treat it like a password (install.sh prints a
# freshly generated random suggestion).
NTFY_TOPIC=
# Access token for a protected ntfy server (sent as "Authorization: Bearer").
NTFY_TOKEN=

# Twilio (optional, only used when "call.enabled" is true in config.json)
TWILIO_ACCOUNT_SID=
# Preferred: an API key (SK...) and its secret, revocable without rotating
# the account auth token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Fallback when no API key is set: the account auth token.
TWILIO_AUTH_TOKEN=
# Caller ID: a phone number you own on Twilio, E.164 format (+<country><number>)
TWILIO_FROM_NUMBER=
# Your own mobile phone number, E.164 format
MEETING_GUARD_CALL_TO=
